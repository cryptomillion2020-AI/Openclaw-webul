VITE_WS_URL=wss://ws.sevinsolutions.com

# OPEN-WEBUI-COMMS-AUTH Stage 2 (Architect 2026-06-02): variable wired here for
# the frontend (`src/hooks/useWebSocket.js:22` reads import.meta.env.VITE_WS_TOKEN
# and sends it as `Sec-WebSocket-Protocol: bearer-<token>`). The value is a SECRET
# and MUST NOT land in this committed file. Operator overrides at build time via
# .env.production.local (gitignored) or an exported env var:
#   echo 'VITE_WS_TOKEN=<paste the token>' > .env.production.local
#   npm run build
VITE_WS_TOKEN=
